{
  "name": "plotter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:e2e": "tsx tests/start-service.ts",
    "dev:service": "node --env-file-if-exists=.env --import tsx server/service.ts --port ${PLOTTER_SERVICE_PORT:-5175} --data-dir ${PLOTTER_SERVICE_DATA_DIR:-user-data}",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && npm run build:service && npm run build:release",
    "build:service": "node scripts/build-service.mjs",
    "build:release": "node scripts/assemble-release.mjs",
    "lint": "eslint . --ignore-pattern server-dist/",
    "test": "VITE_MAPTILER_API_KEY=e2e-test-key vitest run && npm run test:server",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "trip": "tsx src/cli/trip.ts",
    "migrate:supabase": "tsx scripts/migrate-supabase.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "dexie": "^4.4.4",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@local-web/ui": "file:vendor/local-web-ui.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
